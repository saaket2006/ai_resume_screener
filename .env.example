# ==============================================================================
# Nipun (AI Resume Screener) - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in the values for your deployment.
# NEVER commit the actual `.env` file to version control.

# --- APPLICATION SETTINGS ---
API_TITLE="Nipun API"
DEBUG="False"
LOG_LEVEL="INFO"

# --- DATABASE CONFIGURATION ---
# PostgreSQL connection string (e.g. Supabase pooler, AWS RDS, or local PostgreSQL)
# Example: postgresql://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_screener"

# --- JWT AUTHENTICATION ---
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="your-strong-randomly-generated-secret-key"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_MINUTES="1440"

# --- CORS SETTINGS ---
# Comma-separated list of allowed frontend origins.
# If omitted, safe defaults (localhost:3000, 5000, 5500, 8000 and live domains) apply.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5500,https://nipun-platform.web.app"

# --- SECURITY & RATE LIMITING ---
RATE_LIMIT="5/minute"
MAX_FILE_SIZE="5242880"
ALLOWED_EXTENSIONS=".pdf,.docx"

# --- AI & LLM RECOMMENDATION ENHANCEMENTS (OPTIONAL) ---
# If omitted, the screening engine falls back to heuristic recommendation estimation.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --- FIREBASE CLIENT CONFIGURATION (LEGACY REFERENCE) ---
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# --- EMAIL SERVICE (OPTIONAL / FUTURE SMTP) ---
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-email-app-password"
